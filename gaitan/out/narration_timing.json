{
  "narration_source": "scratch",
  "music_source": "synthesized",
  "lines": [
    {
      "id": "L01",
      "start": 0.35,
      "end": 1.994,
      "sub": "Pudo cambiar la historia de Colombia."
    },
    {
      "id": "L02",
      "start": 2.2,
      "end": 3.856,
      "sub": "Se llamaba Jorge Eliécer Gaitán."
    },
    {
      "id": "L03",
      "start": 4.15,
      "end": 7.359,
      "sub": "Hijo de una maestra, estudió derecho en Bogotá y en Roma,"
    },
    {
      "id": "L04",
      "start": 7.479,
      "end": 9.066,
      "sub": "y le habló al pueblo como nadie."
    },
    {
      "id": "L05",
      "start": 9.186,
      "end": 13.281,
      "sub": "En 1929 denunció en el Congreso la masacre de las bananeras."
    },
    {
      "id": "L06",
      "start": 13.401,
      "end": 16.985,
      "sub": "Multitudes lo seguían. Muchos lo veían como el próximo presidente."
    },
    {
      "id": "L07",
      "start": 17.15,
      "end": 20.712,
      "sub": "Pero el 9 de abril de 1948, en Bogotá,"
    },
    {
      "id": "L08",
      "start": 22.0,
      "end": 22.75,
      "sub": "le dispararon."
    },
    {
      "id": "L09",
      "start": 23.15,
      "end": 24.233,
      "sub": "Murió esa misma tarde."
    },
    {
      "id": "L10",
      "start": 25.0,
      "end": 25.769,
      "sub": "Bogotá ardió."
    },
    {
      "id": "L11",
      "start": 26.2,
      "end": 28.228,
      "sub": "Y Colombia nunca volvió a ser la misma."
    }
  ]
}